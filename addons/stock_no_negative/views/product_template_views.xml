<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_no_negative" model="ir.ui.view">
        <field name="name">product.template.form.no.negative</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.view_template_property_form"/>
        <field name="arch" type="xml">
            <field name="is_storable" position="after">
                <field name="allow_negative_stock"
                       invisible="not is_storable"/>
            </field>
        </field>
    </record>
</odoo>
