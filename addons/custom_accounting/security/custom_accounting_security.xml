<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ══ Privilege (replaces ir.module.category on res.groups in Odoo 19) ═ -->
        <record id="privilege_custom_accounting" model="res.groups.privilege">
            <field name="name">Custom Accounting</field>
            <field name="sequence">50</field>
            <field name="category_id" ref="base.module_category_accounting"/>
        </record>

        <!-- ══ Groups ════════════════════════════════════════════════
             In Odoo 19:
             - category_id moves to res.groups.privilege (separate model)
             - res.groups now has: name, sequence, privilege_id, implied_ids, comment
             - 'users' field removed from res.groups
        -->
        <record id="group_custom_accounting_user" model="res.groups">
            <field name="name">User</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="privilege_custom_accounting"/>
            <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
            <field name="comment">Can view chart of accounts and journal entry breakdown on invoices.</field>
        </record>

        <record id="group_custom_accounting_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="privilege_custom_accounting"/>
            <field name="implied_ids" eval="[(4, ref('custom_accounting.group_custom_accounting_user'))]"/>
            <field name="comment">Full access: create/edit accounts, periods, journal lines.</field>
        </record>

    </data>
</odoo>
