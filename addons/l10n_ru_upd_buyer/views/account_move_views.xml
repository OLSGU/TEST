<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Кнопка на форме входящего счёта-фактуры -->
    <record id="view_account_move_upd_buyer_inherit" model="ir.ui.view">
        <field name="name">account.move.form.upd.buyer</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Смарт-кнопка в верхнем правом углу формы -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_upd_buyer"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        invisible="upd_buyer_count == 0">
                    <field name="upd_buyer_count" widget="statinfo"
                           string="УПД покупателя"/>
                </button>
            </xpath>

            <!-- Кнопка в header — только для входящих счетов в статусе posted -->
            <xpath expr="//button[@name='action_register_payment']" position="after">
                <button name="action_create_upd_buyer"
                        string="Создать УПД покупателя"
                        type="object"
                        class="btn-secondary"
                        invisible="move_type not in ('in_invoice', 'in_refund') or state != 'posted'"/>
            </xpath>

        </field>
    </record>

</odoo>
