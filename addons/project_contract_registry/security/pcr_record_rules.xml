            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_pcr_contract_user_write" model="ir.rule">
            <field name="name">Договоры: пользователь — изменение своих</field>
            <field name="model_id" ref="model_pcr_contract"/>
            <field name="groups" eval="[(4, ref('group_pcr_user'))]"/>
            <field name="domain_force">['|', ('create_uid', '=', user.id), ('project_id.manager_id', '=', user.id)]</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- =================== Документы =================== -->

        <record id="rule_pcr_document_manager" model="ir.rule">
