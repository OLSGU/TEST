        </record>

        <record id="rule_pcr_document_user_read" model="ir.rule">
            <field name="name">Документы: пользователь — чтение всех</field>
            <field name="model_id" ref="model_pcr_document"/>
            <field name="groups" eval="[(4, ref('group_pcr_user'))]"/>
