<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pcr_contract_list" model="ir.ui.view">
        <field name="name">pcr.contract.list</field>
        <field name="model">pcr.contract</field>
        <field name="arch" type="xml">
            <list string="Договоры">
                <field name="name"/>
                <field name="title"/>
                <field name="project_id"/>
                <field name="partner_id"/>
                <field name="contract_type"/>
                <field name="date_signed"/>
                <field name="amount"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="document_count" string="Документов"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state in ('signed', 'active')"
                       decoration-success="state == 'closed'"
                       decoration-danger="state == 'terminated'"/>
            </list>
        </field>
    </record>

    <record id="view_pcr_contract_form" model="ir.ui.view">
        <field name="name">pcr.contract.form</field>
        <field name="model">pcr.contract</field>
        <field name="arch" type="xml">
            <form string="Договор">
                <header>
                    <button name="action_set_signed" type="object" string="Подписан"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_set_active" type="object" string="Активировать"
                            class="oe_highlight" invisible="state != 'signed'"/>
                    <button name="action_set_closed" type="object" string="Закрыть"
                            invisible="state not in ('signed', 'active')"/>
                    <button name="action_set_terminated" type="object" string="Расторгнуть"
                            invisible="state in ('draft', 'closed', 'terminated')"/>
                    <button name="action_set_draft" type="object" string="В черновик"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,signed,active,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_documents" type="object"
                                class="oe_stat_button" icon="fa-files-o">
                            <field name="document_count" widget="statinfo"
                                   string="Документы"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="partner_id"/>
                            <field name="title"/>
                            <field name="contract_type"/>
                        </group>
                        <group>
                            <field name="date_signed"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="amount"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Документы" name="documents">
                            <field name="document_ids" context="{'default_contract_id': id}">
                                <list string="Документы">
                                    <field name="reference"/>
                                    <field name="name"/>
                                    <field name="doc_type"/>
                                    <field name="date"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Примечание" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_pcr_contract_search" model="ir.ui.view">
        <field name="name">pcr.contract.search</field>
        <field name="model">pcr.contract</field>
        <field name="arch" type="xml">
            <search string="Поиск договоров">
                <field name="name"/>
                <field name="title"/>
                <field name="project_id"/>
                <field name="partner_id"/>
                <filter name="filter_draft" string="Черновики"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="filter_active" string="Действующие"
                        domain="[('state', '=', 'active')]"/>
                <separator/>
                <filter name="filter_archived" string="В архиве"
                        domain="[('active', '=', False)]"/>
                <group expand="0" string="Группировка">
                    <filter name="group_state" string="Статус"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_project" string="Проект"
                            context="{'group_by': 'project_id'}"/>
                    <filter name="group_partner" string="Контрагент"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="group_type" string="Тип договора"
                            context="{'group_by': 'contract_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pcr_contract" model="ir.actions.act_window">
        <field name="name">Договоры</field>
        <field name="res_model">pcr.contract</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_pcr_contract_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Зарегистрируйте первый договор
            </p>
            <p>
                Каждый договор привязан к проекту и хранит свои документы.
            </p>
        </field>
    </record>

</odoo>
