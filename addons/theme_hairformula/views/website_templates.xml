<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Inject Cormorant Garamond + Manrope into <head> for every page.
        Inherits the base layout used by all frontend pages.
    -->
    <template id="theme_hairformula_fonts"
              name="HairFormula — Fonts"
              inherit_id="web.layout">
        <xpath expr="//head" position="inside">
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin"/>
            <link rel="stylesheet"
                  href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&amp;family=Manrope:wght@300;400;500;600&amp;display=swap"/>
        </xpath>
    </template>
</odoo>
