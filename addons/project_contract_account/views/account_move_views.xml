<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Форма счёта: «Договор» и «Проект» под контрагентом -->
    <record id="view_move_form_pcr" model="ir.ui.view">
        <field name="name">account.move.form.pcr</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_left_group']" position="inside">
                <field name="pcr_contract_id"
                       options="{'no_create': True}"
                       invisible="move_type == 'entry'"
                       readonly="state != 'draft'"/>
                <field name="pcr_project_id"
                       options="{'no_create': True}"
                       invisible="move_type == 'entry'"
                       readonly="state != 'draft'"/>
            </xpath>
        </field>
    </record>

    <!-- Список счетов: колонки «Договор» и «Проект» -->
    <record id="view_invoice_tree_pcr" model="ir.ui.view">
        <field name="name">account.move.list.pcr</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <field name="ref" position="after">
                <field name="pcr_contract_id" optional="show"/>
                <field name="pcr_project_id" optional="hide"/>
            </field>
        </field>
    </record>

    <!-- Поиск и группировка счетов по договору и проекту -->
    <record id="view_account_invoice_filter_pcr" model="ir.ui.view">
        <field name="name">account.move.search.pcr</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="pcr_contract_id"/>
                <field name="pcr_project_id"/>
            </field>
            <filter name="partner" position="after">
                <filter string="Договор" name="group_pcr_contract"
                        context="{'group_by': 'pcr_contract_id'}"/>
                <filter string="Проект" name="group_pcr_project"
                        context="{'group_by': 'pcr_project_id'}"/>
            </filter>
        </field>
    </record>

</odoo>
