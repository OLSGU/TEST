# Copy this file to `.env` and adjust as needed:  cp .env.example .env
#
# Odoo image tag — use the current stable Community release.
ODOO_VERSION=18.0

# Host port the Odoo web UI is published on (http://localhost:${ODOO_PORT}).
ODOO_PORT=8069

# PostgreSQL credentials shared between the db and odoo containers.
DB_USER=odoo
DB_PASSWORD=odoo
